{
  "$defs": {
    "JsonPath": {
      "description": "JSON form of a path: `path` is always present (lossy when needed) and\n`path_bytes` carries the exact bytes, base64, when the path is not UTF-8.",
      "properties": {
        "path": {
          "type": "string"
        },
        "path_bytes": {
          "type": [
            "string",
            "null"
          ]
        }
      },
      "required": [
        "path"
      ],
      "type": "object"
    },
    "ScanInfo": {
      "description": "Facts about the scan every disk report includes.",
      "properties": {
        "cancelled": {
          "type": "boolean"
        },
        "elapsed_ms": {
          "format": "uint64",
          "minimum": 0,
          "type": "integer"
        },
        "error_samples": {
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        "errors": {
          "description": "Entries that could not be read (permission errors).",
          "format": "uint64",
          "minimum": 0,
          "type": "integer"
        },
        "notes": {
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        "path": {
          "type": "string"
        },
        "path_bytes": {
          "type": [
            "string",
            "null"
          ]
        },
        "skipped": {
          "description": "Mount points not entered.",
          "items": {
            "$ref": "#/$defs/JsonPath"
          },
          "type": "array"
        },
        "total_apparent": {
          "format": "uint64",
          "minimum": 0,
          "type": "integer"
        },
        "total_real": {
          "format": "uint64",
          "minimum": 0,
          "type": "integer"
        },
        "warnings": {
          "items": {
            "type": "string"
          },
          "type": "array"
        }
      },
      "required": [
        "path",
        "total_real",
        "total_apparent",
        "elapsed_ms",
        "errors",
        "error_samples",
        "skipped",
        "notes",
        "warnings",
        "cancelled"
      ],
      "type": "object"
    },
    "TopEntry": {
      "description": "JSON form of a path: `path` is always present (lossy when needed) and\n`path_bytes` carries the exact bytes, base64, when the path is not UTF-8.",
      "properties": {
        "apparent": {
          "format": "uint64",
          "minimum": 0,
          "type": "integer"
        },
        "category": {
          "type": [
            "string",
            "null"
          ]
        },
        "depth": {
          "format": "uint",
          "minimum": 0,
          "type": "integer"
        },
        "files": {
          "format": "uint64",
          "minimum": 0,
          "type": "integer"
        },
        "loose_files": {
          "description": "Files directly inside the parent, shown as one row.",
          "type": "boolean"
        },
        "path": {
          "type": "string"
        },
        "path_bytes": {
          "type": [
            "string",
            "null"
          ]
        },
        "real": {
          "format": "uint64",
          "minimum": 0,
          "type": "integer"
        },
        "share": {
          "description": "Fraction of the scanned total.",
          "format": "double",
          "type": "number"
        }
      },
      "required": [
        "path",
        "real",
        "apparent",
        "files",
        "share",
        "depth",
        "loose_files"
      ],
      "type": "object"
    }
  },
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "properties": {
    "command": {
      "type": "string"
    },
    "depth": {
      "format": "uint",
      "minimum": 0,
      "type": "integer"
    },
    "entries": {
      "items": {
        "$ref": "#/$defs/TopEntry"
      },
      "type": "array"
    },
    "scan": {
      "$ref": "#/$defs/ScanInfo"
    },
    "schema_version": {
      "format": "uint32",
      "minimum": 0,
      "type": "integer"
    }
  },
  "required": [
    "schema_version",
    "command",
    "scan",
    "depth",
    "entries"
  ],
  "title": "Envelope",
  "type": "object"
}
