{
  "$defs": {
    "ItemOutcome": {
      "enum": [
        "done",
        "skipped",
        "failed"
      ],
      "type": "string"
    },
    "ItemResult": {
      "description": "JSON form of a path: `path` is always present (lossy when needed) and\n`path_bytes` carries the exact bytes, base64, when the path is not UTF-8.",
      "properties": {
        "bytes": {
          "format": "uint64",
          "minimum": 0,
          "type": "integer"
        },
        "detail": {
          "type": [
            "string",
            "null"
          ]
        },
        "outcome": {
          "$ref": "#/$defs/ItemOutcome"
        },
        "path": {
          "type": "string"
        },
        "path_bytes": {
          "type": [
            "string",
            "null"
          ]
        },
        "trash_path": {
          "anyOf": [
            {
              "$ref": "#/$defs/JsonPath"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": [
        "path",
        "outcome",
        "bytes"
      ],
      "type": "object"
    },
    "JsonPath": {
      "description": "JSON form of a path: `path` is always present (lossy when needed) and\n`path_bytes` carries the exact bytes, base64, when the path is not UTF-8.",
      "properties": {
        "path": {
          "type": "string"
        },
        "path_bytes": {
          "type": [
            "string",
            "null"
          ]
        }
      },
      "required": [
        "path"
      ],
      "type": "object"
    },
    "TrashItemOut": {
      "description": "JSON form of a path: `path` is always present (lossy when needed) and\n`path_bytes` carries the exact bytes, base64, when the path is not UTF-8.",
      "properties": {
        "deleted_at": {
          "format": "int64",
          "type": [
            "integer",
            "null"
          ]
        },
        "original": {
          "anyOf": [
            {
              "$ref": "#/$defs/JsonPath"
            },
            {
              "type": "null"
            }
          ]
        },
        "path": {
          "type": "string"
        },
        "path_bytes": {
          "type": [
            "string",
            "null"
          ]
        },
        "size": {
          "format": "uint64",
          "minimum": 0,
          "type": "integer"
        }
      },
      "required": [
        "path",
        "size"
      ],
      "type": "object"
    }
  },
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "properties": {
    "command": {
      "type": "string"
    },
    "emptied": {
      "items": {
        "$ref": "#/$defs/ItemResult"
      },
      "type": [
        "array",
        "null"
      ]
    },
    "items": {
      "items": {
        "$ref": "#/$defs/TrashItemOut"
      },
      "type": "array"
    },
    "schema_version": {
      "format": "uint32",
      "minimum": 0,
      "type": "integer"
    },
    "total": {
      "format": "uint64",
      "minimum": 0,
      "type": "integer"
    },
    "trash_dirs": {
      "items": {
        "$ref": "#/$defs/JsonPath"
      },
      "type": "array"
    }
  },
  "required": [
    "schema_version",
    "command",
    "trash_dirs",
    "total",
    "items"
  ],
  "title": "Envelope",
  "type": "object"
}
